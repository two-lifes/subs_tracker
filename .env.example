# Token from @BotFather
BOT_TOKEN=
# Your numeric Telegram id (e.g. from @userinfobot); the bot ignores everyone else
ALLOWED_USER_ID=
# Optional proxy for Telegram API: socks5://user:pass@host:port or http://user:pass@host:port
PROXY_URL=
# SQLite file location
DB_PATH=data/subs.db

# Read-only HTTP API (see README). Empty token disables it; generate one with
# python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=
# 127.0.0.1 locally; the server's docker-compose sets 0.0.0.0 inside the container
API_HOST=127.0.0.1
API_PORT=8080
# Telegram id whose data the API serves; defaults to ALLOWED_USER_ID
API_TELEGRAM_ID=
